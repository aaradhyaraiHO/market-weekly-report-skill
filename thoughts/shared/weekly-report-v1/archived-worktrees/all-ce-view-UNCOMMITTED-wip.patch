 OUT_DIR = REPO_ROOT / ".cache" / "weekly_report"
 
 
+def _load_groups(market_slug: str) -> dict:
+    """Load persisted BGM groups for a market.
+
+    Priority: groups file (.cache/weekly_report/groups_{slug}.json) written by
+    the report's Export button, then config.DEFAULT_GROUPS fallback.
+    """
+    gpath = OUT_DIR / f"groups_{market_slug}.json"
+    if gpath.exists():
+        try:
+            obj = json.loads(gpath.read_text())
+            groups = obj.get("groups", obj) if isinstance(obj, dict) else {}
+            if groups:
+                print(f"  [groups] loaded {len(groups)} group(s) from {gpath.name}")
+                return groups
+        except Exception:
+            pass
+    return config.DEFAULT_GROUPS.get(market_slug, {})
+
+
