+/* ---------- Slack context card renderer (shared by §2 Market Review + CE drawer) ---------- */
+const _CAT_COLOR={commission_change:'violet',availability:'amber',campaign_decision:'blue',
+  promo_start_end:'amber',new_launch:'green',competitive_intel:'red',supply_issue:'amber',
+  bug:'red',strategy:'violet'};
+const _CAT_LABEL={commission_change:'TR change',availability:'availability',campaign_decision:'campaign',
+  promo_start_end:'promo',new_launch:'new launch',competitive_intel:'competitive',supply_issue:'supply',
+  bug:'bug',strategy:'strategy'};
+function _catChip(cat){
+  const c=_CAT_COLOR[cat]||'ghost', l=_CAT_LABEL[cat]||cat;
+  return '<span class="chip '+c+'">'+esc(l)+'</span>';
+}
+function _ctxCard(c){
+  const src = esc(c.source||'slack')+(c.channel?' · '+esc(c.channel):'');
+  const link = c.permalink ? ' <a class="outlink" href="'+esc(c.permalink)+'" target="_blank" rel="noopener">thread ↗</a>' : '';
+  return '<div class="mr-context-item">'+
+    '<div class="mr-src">'+src+(c.author?' · '+esc(c.author):'')+(c.category?' '+_catChip(c.category):'')+'</div>'+
+    '<div class="mr-txt">'+esc(c.text)+link+'</div>'+
+    (c.timestamp?'<div class="mr-when">'+esc(c.timestamp)+'</div>':'')+'</div>';
+}
